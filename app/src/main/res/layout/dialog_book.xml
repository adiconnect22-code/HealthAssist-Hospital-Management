<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TxtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Book Appointment"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/bookClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookDate"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_calendar"
        android:drawableTint="@color/text_secondary"
        android:focusable="true"
        android:text="Select Date" />

    <TextView
        android:id="@+id/bookTime"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_clock"
        android:drawableTint="@color/text_secondary"
        android:focusable="true"
        android:text="Select Time Slot" />

    <TextView
        style="@style/TxtMuted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Capacity check: 3 of 10 filled · slot available" />

    <EditText
        android:id="@+id/bookNotes"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="top|start"
        android:hint="Notes (optional)"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bookSend"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Send Request" />

        <TextView
            android:id="@+id/bookCancel"
            style="@style/BtnOutline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookWaitlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:padding="4dp"
        android:text="Join Waiting List instead (if full)"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
