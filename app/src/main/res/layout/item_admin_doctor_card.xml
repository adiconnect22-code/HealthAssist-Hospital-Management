<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Left Side: Square Rounded Doctor Portrait Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgDoctorPhoto"
            android:layout_width="85dp"
            android:layout_height="95dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/doc_male_1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <!-- Right Side Controls Column (Menu/Dustbin, Status Pill, Call & Mail Action Buttons) -->
        <LinearLayout
            android:id="@+id/layoutRightControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/imgDoctorPhoto"
            android:gravity="end"
            android:orientation="vertical">

            <!-- 3 Dots Options / Dustbin Delete Button -->
            <ImageView
                android:id="@+id/btnDeleteDoctor"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Options"
                android:src="@drawable/ic_delete_trash"
                app:tint="@color/admin_text_secondary" />

            <!-- Availability Status Pill Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="#064E3B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● Available"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Phone Call & Email Circular Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCallDoctor"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="#0284C7"
                    android:padding="8dp"
                    android:contentDescription="Call Doctor"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/btnEmailDoctor"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="#1E40AF"
                    android:padding="8dp"
                    android:contentDescription="Email Doctor"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@color/white" />
            </LinearLayout>

        </LinearLayout>

        <!-- Middle Column: Doctor Info Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="98dp"
            android:layout_toStartOf="@id/layoutRightControls"
            android:orientation="vertical">

            <!-- Doctor Name -->
            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Rahul Sharma"
                android:textColor="@color/admin_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Specialization -->
            <TextView
                android:id="@+id/tvDoctorSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="General Physician"
                android:textColor="#38BDF8"
                android:textSize="13sp" />

            <!-- Qualification -->
            <TextView
                android:id="@+id/tvDoctorQual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🎓 MBBS, MD"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />

            <!-- Hospital Name -->
            <TextView
                android:id="@+id/tvDoctorHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🏥 City Care Hospital"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />

            <!-- Location -->
            <TextView
                android:id="@+id/tvDoctorLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📍 Bengaluru"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>